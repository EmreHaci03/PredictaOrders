@model Message
@{
    ViewData["Title"] = "Yeni Mesaj";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .f-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #8a8f98;
        font-weight: 700;
        font-size: 13px;
        margin-bottom: 16px;
    }

        .f-back:hover {
            color: #f96332;
            text-decoration: none;
        }

    .f-hero {
        margin-bottom: 20px;
    }

        .f-hero h2 {
            font-size: 26px;
            font-weight: 800;
            margin: 0;
            color: #2d2d2d;
        }

        .f-hero p {
            margin: 4px 0 0;
            color: #8a8f98;
        }

    .f-card {
        background: #fff;
        border-radius: 18px;
        padding: 28px;
        box-shadow: 0 4px 18px rgba(0,0,0,.05);
    }

    .f-field {
        margin-bottom: 18px;
    }

    .f-label {
        display: block;
        font-size: 13px;
        font-weight: 700;
        color: #4b5563;
        margin-bottom: 6px;
    }

    .f-input {
        width: 100%;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 11px 14px;
        font-size: 14px;
        color: #2d2d2d;
        outline: none;
        background: #fff;
        transition: border-color .15s;
    }

        .f-input:focus {
            border-color: #f96332;
        }

    textarea.f-input {
        min-height: 140px;
        resize: vertical;
        line-height: 1.6;
    }

    .f-hint {
        display: block;
        margin-top: 6px;
        font-size: 12px;
        color: #a3a8b1;
        font-weight: 600;
    }

    .f-alert {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 14px 18px;
        margin-bottom: 20px;
        border-radius: 14px;
        background: rgba(225,29,72,.08);
        color: #be123c;
        font-size: 14px;
        font-weight: 600;
    }

        .f-alert i {
            font-size: 20px;
        }

    .f-ai-note {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        padding: 12px 16px;
        border-radius: 12px;
        background: rgba(124,58,237,.06);
        color: #5b21b6;
        font-size: 13px;
        font-weight: 600;
        line-height: 1.5;
    }

        .f-ai-note i {
            font-size: 18px;
            margin-top: 1px;
        }

    .f-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 24px;
    }

    .btn-cancel {
        padding: 11px 22px;
        border-radius: 12px;
        background: #f3f4f7;
        color: #6b7280 !important;
        font-weight: 700;
    }

        .btn-cancel:hover {
            text-decoration: none;
            background: #e9eaee;
        }

    .btn-save {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 24px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #f96332, #ff8a5c);
        color: #fff;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 8px 20px rgba(249,99,50,.28);
        transition: opacity .15s;
    }

        .btn-save:disabled {
            opacity: .6;
            cursor: not-allowed;
        }
</style>

<div class="container-fluid">

    <a href="/AdminMessage/Index" class="f-back"><i class="zmdi zmdi-arrow-left"></i> Mesajlara dön</a>

    <div class="f-hero">
        <h2>Yeni Mesaj</h2>
        <p>Müşteri adına yeni bir mesaj kaydı oluştur</p>
    </div>

    @if (ViewBag.ToxicError != null)
    {
        <div class="f-alert">
            <i class="zmdi zmdi-block"></i>
            <div>@ViewBag.ToxicError</div>
        </div>
    }

<div class="row">
    <div class="col-lg-12">
        <div class="f-card">
            <form method="post" action="/AdminMessage/CreateMessage" onsubmit="onSave()">

                <div class="row">
                    <div class="col-md-6">
                        <div class="f-field">
                            <label class="f-label" for="CustomerId">Müşteri</label>
                            <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="f-input" required>
                                <option value="">Müşteri seçin…</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="f-field">
                            <label class="f-label" for="Topic">Konu</label>
                            <input asp-for="Topic" class="f-input" list="topicList" placeholder="Örn: Kargo" required />
                            <datalist id="topicList">
                                <option value="Sipariş"></option>
                                <option value="Kargo"></option>
                                <option value="İade"></option>
                                <option value="Ödeme"></option>
                                <option value="Ürün"></option>
                                <option value="Diğer"></option>
                            </datalist>
                            <span class="f-hint">Listeden seçebilir ya da kendin yazabilirsin.</span>
                        </div>
                    </div>
                </div>

                <div class="f-field">
                    <label class="f-label" for="MessageText">Mesaj</label>
                    <textarea asp-for="MessageText" class="f-input" placeholder="Müşterinin mesajı..." required></textarea>
                </div>

                <div class="f-ai-note">
                    <i class="zmdi zmdi-memory"></i>
                    <div>
                        Mesajın duygusu kaydedilirken yapay zeka ile otomatik belirlenir.
                        Hakaret, tehdit veya toksik içerik barındıran mesajlar kaydedilmez.
                    </div>
                </div>

                <div class="f-actions">
                    <a href="/AdminMessage/Index" class="btn-cancel">Vazgeç</a>
                    <button type="submit" class="btn-save" id="SaveBtn"><i class="zmdi zmdi-check"></i> Kaydet</button>
                </div>

            </form>
        </div>
    </div>
</div>

</div>

<script>
    // Kaydet'e basınca butonu kilitle; AI kontrolü birkaç saniye sürebilir, iki kere basılmasın
    function onSave() {
        const btn = document.getElementById('SaveBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="zmdi zmdi-spinner zmdi-hc-spin"></i> Kontrol ediliyor...';
    }
</script>