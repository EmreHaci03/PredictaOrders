@model List<Message>
@{
    ViewData["Title"] = "Mesajlar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;

    int startPage = Math.Max(1, currentPage - 2);
    int endPage = Math.Min(totalPages, currentPage + 2);

    var tr = new System.Globalization.CultureInfo("tr-TR");

    // Duygu etiketine göre renk
    string SentimentClass(string label)
    {
        if (string.IsNullOrEmpty(label)) return "s-neu";
        var l = label.ToLower();
        if (l.Contains("olumlu") && !l.Contains("olumsuz") || l.Contains("positive")) return "s-pos";
        if (l.Contains("olumsuz") || l.Contains("negative")) return "s-neg";
        return "s-neu";
    }
    // Duygu etiketini Türkçeye çevir
    string SentimentText(string label)
    {
        if (string.IsNullOrEmpty(label)) return "Bilinmiyor";

        return label.ToLower() switch
        {
            "positive" => "Olumlu",
            "neutral" => "Nötr",
            "negative" => "Olumsuz",
            _ => label
        };
    }

    // Bu sayfadaki duygu dağılımı
    int pagePositive = Model.Count(x => SentimentClass(x.SentimentLabel) == "s-pos");
    int pageNeutral = Model.Count(x => SentimentClass(x.SentimentLabel) == "s-neu");
    int pageNegative = Model.Count(x => SentimentClass(x.SentimentLabel) == "s-neg");
}

<style>
    .page-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
    }

        .page-hero h2 {
            font-size: 26px;
            font-weight: 800;
            margin: 0;
            color: #2d2d2d;
        }

        .page-hero p {
            margin: 4px 0 0;
            color: #8a8f98;
        }

    .stat-box {
        background: #fff;
        border-radius: 16px;
        padding: 20px 22px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,.05);
        margin-bottom: 24px;
    }

    .stat-icon {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        font-size: 26px;
        flex-shrink: 0;
    }

        .stat-icon.orange {
            background: rgba(249,99,50,.12);
            color: #f96332;
        }

        .stat-icon.green {
            background: rgba(16,185,129,.12);
            color: #059669;
        }

        .stat-icon.gray {
            background: rgba(148,163,184,.16);
            color: #64748b;
        }

        .stat-icon.red {
            background: rgba(225,29,72,.12);
            color: #e11d48;
        }

    .stat-box h3 {
        margin: 0;
        font-size: 24px;
        font-weight: 800;
        color: #2d2d2d;
    }

    .stat-box span {
        color: #8a8f98;
        font-size: 13px;
    }

    .list-card {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 4px 18px rgba(0,0,0,.05);
        overflow: hidden;
    }

    .list-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid #f0f1f4;
    }

        .list-card-header h4 {
            margin: 0;
            font-size: 16px;
            font-weight: 700;
        }

    .header-tools {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .search-box {
        position: relative;
    }

        .search-box i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #a3a8b1;
        }

        .search-box input {
            border: 1px solid #e6e8ee;
            border-radius: 10px;
            padding: 9px 14px 9px 38px;
            width: 240px;
            outline: none;
        }

            .search-box input:focus {
                border-color: #f96332;
            }

    .filter-select {
        border: 1px solid #e6e8ee;
        border-radius: 10px;
        padding: 9px 12px;
        outline: none;
        color: #4b5563;
        font-weight: 600;
        background: #fff;
    }

    .m-table {
        width: 100%;
        margin: 0;
    }

        .m-table thead th {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #a3a8b1;
            font-weight: 700;
            padding: 14px 20px;
            border: none;
            background: #fafbfc;
            white-space: nowrap;
        }

        .m-table tbody td {
            padding: 14px 20px;
            vertical-align: middle;
            border-top: 1px solid #f3f4f7;
        }

        .m-table tbody tr:hover {
            background: #fff8f5;
        }

    .customer-cell {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 200px;
    }

    .customer-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        flex-shrink: 0;
        background: linear-gradient(135deg, #f96332, #ffb199);
        color: #fff;
        font-weight: 800;
        font-size: 14px;
        display: grid;
        place-items: center;
    }

    .customer-name {
        font-weight: 700;
        color: #2d2d2d;
        display: block;
    }

        .customer-name:hover {
            color: #f96332;
            text-decoration: none;
        }

    .customer-id {
        font-size: 12px;
        color: #a3a8b1;
    }

    .topic-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        background: rgba(59,130,246,.1);
        color: #2563eb;
        white-space: nowrap;
    }

    .message-text {
        color: #4b5563;
        font-size: 13px;
        max-width: 420px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.5;
    }

    .sentiment {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

        .sentiment::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

    .s-pos {
        background: rgba(16,185,129,.12);
        color: #059669;
    }

    .s-neu {
        background: rgba(148,163,184,.16);
        color: #64748b;
    }

    .s-neg {
        background: rgba(225,29,72,.12);
        color: #e11d48;
    }

    .date-cell {
        white-space: nowrap;
        color: #4b5563;
        font-size: 13px;
    }

        .date-cell small {
            display: block;
            color: #a3a8b1;
            font-size: 12px;
        }

    .empty-state {
        text-align: center;
        padding: 50px 20px;
        color: #a3a8b1;
    }

        .empty-state i {
            font-size: 48px;
            display: block;
            margin-bottom: 10px;
        }

    .pager {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding: 16px 24px;
        border-top: 1px solid #f0f1f4;
    }

    .pager-info {
        color: #8a8f98;
        font-size: 13px;
    }

    .pager-buttons {
        display: flex;
        gap: 6px;
    }

    .pager-btn {
        min-width: 36px;
        height: 36px;
        padding: 0 10px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #f3f4f7;
        color: #6b7280;
        font-weight: 600;
        transition: background .15s;
    }

        .pager-btn:hover {
            background: #ffe9e0;
            color: #f96332;
            text-decoration: none;
        }

        .pager-btn.active {
            background: linear-gradient(135deg, #f96332, #ff8a5c);
            color: #fff;
        }

        .pager-btn.disabled {
            pointer-events: none;
            opacity: .4;
        }
    .btn-hero {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 22px;
        border-radius: 12px;
        background: linear-gradient(135deg, #f96332, #ff8a5c);
        color: #fff !important;
        font-weight: 600;
        box-shadow: 0 8px 20px rgba(249,99,50,.3);
        transition: transform .2s;
    }

        .btn-hero:hover {
            transform: translateY(-2px);
            text-decoration: none;
        }

    .action-btn {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-grid;
        place-items: center;
        border: none;
        font-size: 16px;
        cursor: pointer;
        transition: transform .15s;
    }

        .action-btn:hover {
            transform: translateY(-2px);
            text-decoration: none;
        }

        .action-btn.edit {
            background: rgba(245,158,11,.14);
            color: #d97706;
        }

        .action-btn.delete {
            background: rgba(225,29,72,.12);
            color: #e11d48;
        }

    .delete-modal .modal-content {
        border: none;
        border-radius: 18px;
    }

    .delete-modal .modal-body {
        text-align: center;
        padding: 36px 30px 20px;
    }

    .delete-icon {
        width: 76px;
        height: 76px;
        border-radius: 50%;
        margin: 0 auto 18px;
        display: grid;
        place-items: center;
        font-size: 36px;
        background: rgba(225,29,72,.12);
        color: #e11d48;
    }

    .delete-name {
        display: inline-block;
        margin: 8px 0 12px;
        padding: 5px 16px;
        border-radius: 999px;
        background: #f3f4f7;
        font-weight: 700;
    }

    .delete-modal .modal-footer {
        border-top: none;
        justify-content: center;
        gap: 10px;
        padding: 0 30px 30px;
    }

        .delete-modal .modal-footer .btn {
            min-width: 120px;
            border-radius: 10px;
        }
</style>

<div class="container-fluid">

    <div class="page-hero">
        <div>
            <h2>Mesajlar</h2>
            <p>Müşterilerden gelen mesajlar ve duygu analizleri</p>
        </div>
        <a href="/AdminMessage/CreateMessage" class="btn-hero">
            <i class="zmdi zmdi-plus"></i> Yeni Mesaj
        </a>
    </div>

    <!-- İSTATİSTİK KARTLARI -->
    <div class="row">
        <div class="col-lg-3 col-md-6">
            <div class="stat-box">
                <div class="stat-icon orange"><i class="zmdi zmdi-email"></i></div>
                <div>
                    <h3>@totalCount.ToString("N0")</h3>
                    <span>Toplam Mesaj</span>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="stat-box">
                <div class="stat-icon green"><i class="zmdi zmdi-mood"></i></div>
                <div>
                    <h3>@pagePositive</h3>
                    <span>Olumlu (bu sayfa)</span>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="stat-box">
                <div class="stat-icon gray"><i class="zmdi zmdi-minus-circle-outline"></i></div>
                <div>
                    <h3>@pageNeutral</h3>
                    <span>Nötr (bu sayfa)</span>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="stat-box">
                <div class="stat-icon red"><i class="zmdi zmdi-mood-bad"></i></div>
                <div>
                    <h3>@pageNegative</h3>
                    <span>Olumsuz (bu sayfa)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- LİSTE -->
    <div class="list-card">
        <div class="list-card-header">
            <h4>Mesaj Listesi</h4>
            <div class="header-tools">
                <select class="filter-select" id="sentimentFilter" onchange="filterMessages()">
                    <option value="">Tüm duygular</option>
                    <option value="s-pos">Olumlu</option>
                    <option value="s-neu">Nötr</option>
                    <option value="s-neg">Olumsuz</option>
                </select>
                <div class="search-box">
                    <i class="zmdi zmdi-search"></i>
                    <input type="text" id="messageSearch" placeholder="Bu sayfada ara..." onkeyup="filterMessages()" />
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="m-table">
                <thead>
                    <tr>
                        <th>Müşteri</th>
                        <th>Konu</th>
                        <th>Mesaj</th>
                        <th>Duygu</th>
                        <th>Tarih</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody id="messageList">
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <i class="zmdi zmdi-email-open"></i>
                                    Henüz mesaj yok
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        var initials = (item.Customer?.CustomerName?.Substring(0, 1) ?? "") + (item.Customer?.CustomerSurname?.Substring(0, 1) ?? "");
                        var sClass = SentimentClass(item.SentimentLabel);

                        <tr data-sentiment="@sClass">
                            <td>
                                <div class="customer-cell">
                                    <div class="customer-avatar">@initials.ToUpper()</div>
                                    <div>
                                        <a href="/AdminCustomer/CustomerDetail?customerId=@item.CustomerId" class="customer-name">
                                            @item.Customer?.CustomerName @item.Customer?.CustomerSurname
                                        </a>
                                        <span class="customer-id">#@item.CustomerId</span>
                                    </div>
                                </div>
                            </td>
                            <td><span class="topic-badge">@item.Topic</span></td>
                            <td><div class="message-text" title="@item.MessageText">@item.MessageText</div></td>
                            <td><span class="sentiment @sClass">@SentimentText(item.SentimentLabel)</span></td>
                            <td class="date-cell">
                                @item.CreatedDate.ToString("dd MMM yyyy", tr)
                                <small>@item.CreatedDate.ToString("HH:mm")</small>
                            </td>
                            <td class="text-right" style="white-space:nowrap;">
                                <a href="/AdminMessage/UpdateMessage/@item.MessageId" class="action-btn edit" title="Güncelle">
                                    <i class="zmdi zmdi-edit"></i>
                                </a>
                                <button type="button" class="action-btn delete" title="Sil"
                                        data-toggle="modal" data-target="#deleteModal"
                                        data-name="@item.Customer?.CustomerName @item.Customer?.CustomerSurname · @item.Topic"
                                        data-url="/AdminMessage/DeleteMessage/@item.MessageId"
                                        onclick="setDeleteModal(this)">
                                    <i class="zmdi zmdi-delete"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="pager">
                <span class="pager-info">Sayfa @currentPage / @totalPages · Toplam @totalCount.ToString("N0") mesaj</span>
                <div class="pager-buttons">
                    <a href="?page=1" class="pager-btn @(currentPage == 1 ? "disabled" : "")" title="İlk sayfa"><i class="zmdi zmdi-skip-previous"></i></a>
                    <a href="?page=@(currentPage - 1)" class="pager-btn @(currentPage == 1 ? "disabled" : "")" title="Önceki"><i class="zmdi zmdi-chevron-left"></i></a>

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <a href="?page=@i" class="pager-btn @(i == currentPage ? "active" : "")">@i</a>
                    }

                    <a href="?page=@(currentPage + 1)" class="pager-btn @(currentPage == totalPages ? "disabled" : "")" title="Sonraki"><i class="zmdi zmdi-chevron-right"></i></a>
                    <a href="?page=@totalPages" class="pager-btn @(currentPage == totalPages ? "disabled" : "")" title="Son sayfa"><i class="zmdi zmdi-skip-next"></i></a>
                </div>
            </div>
        }
    </div>
</div>
<div class="modal fade delete-modal" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="delete-icon"><i class="zmdi zmdi-delete"></i></div>
                <h4 style="font-weight:700;">Mesajı Sil</h4>
                <p class="m-b-0">Aşağıdaki mesajı silmek üzeresin:</p>
                <span class="delete-name" id="deleteName"></span>
                <p class="text-muted" style="font-size:13px;">
                    <i class="zmdi zmdi-alert-triangle"></i> Bu işlem geri alınamaz.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Vazgeç</button>
                <form id="deleteForm" method="post" style="display:inline;">
                    <button type="submit" class="btn btn-danger">Evet, Sil</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function setDeleteModal(button) {
        document.getElementById("deleteName").innerText = button.getAttribute("data-name");
        document.getElementById("deleteForm").setAttribute("action", button.getAttribute("data-url"));
    }

    function filterMessages() {
        var search = document.getElementById("messageSearch").value.toLowerCase();
        var sentiment = document.getElementById("sentimentFilter").value;
        var rows = document.querySelectorAll("#messageList tr[data-sentiment]");

        rows.forEach(function (row) {
            var textMatch = row.innerText.toLowerCase().includes(search);
            var sentimentMatch = !sentiment || row.getAttribute("data-sentiment") === sentiment;
            row.style.display = textMatch && sentimentMatch ? "" : "none";
        });
    }
</script>