@model Message
@{
    ViewData["Title"] = "Mesajı Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    // Mevcut duygu etiketi (Türkçe ve renk)
    string current = Model.SentimentLabel?.ToLower() ?? "";

    string sentimentText = current switch
    {
        "positive" => "Olumlu",
        "negative" => "Olumsuz",
        "neutral" => "Nötr",
        _ => "Belirlenmemiş"
    };

    string sentimentClass = current switch
    {
        "positive" => "s-pos",
        "negative" => "s-neg",
        _ => "s-neu"
    };
}

<style>
    .f-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #8a8f98;
        font-weight: 700;
        font-size: 13px;
        margin-bottom: 16px;
    }

        .f-back:hover {
            color: #f96332;
            text-decoration: none;
        }

    .f-hero {
        margin-bottom: 20px;
    }

        .f-hero h2 {
            font-size: 26px;
            font-weight: 800;
            margin: 0;
            color: #2d2d2d;
        }

        .f-hero p {
            margin: 4px 0 0;
            color: #8a8f98;
        }

    .f-card {
        background: #fff;
        border-radius: 18px;
        padding: 28px;
        box-shadow: 0 4px 18px rgba(0,0,0,.05);
        max-width: 760px;
    }

    .f-field {
        margin-bottom: 18px;
    }

    .f-label {
        display: block;
        font-size: 13px;
        font-weight: 700;
        color: #4b5563;
        margin-bottom: 6px;
    }

    .f-input {
        width: 100%;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 11px 14px;
        font-size: 14px;
        color: #2d2d2d;
        outline: none;
        background: #fff;
        transition: border-color .15s;
    }

        .f-input:focus {
            border-color: #f96332;
        }

    textarea.f-input {
        min-height: 140px;
        resize: vertical;
        line-height: 1.6;
    }

    .f-alert {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 14px 18px;
        margin-bottom: 20px;
        border-radius: 14px;
        background: rgba(225,29,72,.08);
        color: #be123c;
        font-size: 14px;
        font-weight: 600;
        max-width: 760px;
    }

        .f-alert i {
            font-size: 20px;
        }

    /* Mevcut duygu */
    .f-current {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        padding: 12px 16px;
        border-radius: 12px;
        background: #fafbfc;
        border: 1px solid #f0f1f4;
        margin-bottom: 18px;
        font-size: 13px;
        font-weight: 600;
        color: #6b7280;
    }

    .sentiment {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
    }

        .sentiment::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

    .s-pos {
        background: rgba(16,185,129,.12);
        color: #059669;
    }

    .s-neu {
        background: rgba(148,163,184,.16);
        color: #64748b;
    }

    .s-neg {
        background: rgba(225,29,72,.12);
        color: #e11d48;
    }

    .f-ai-note {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        padding: 12px 16px;
        border-radius: 12px;
        background: rgba(124,58,237,.06);
        color: #5b21b6;
        font-size: 13px;
        font-weight: 600;
        line-height: 1.5;
    }

        .f-ai-note i {
            font-size: 18px;
            margin-top: 1px;
        }

    .f-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 24px;
    }

    .btn-cancel {
        padding: 11px 22px;
        border-radius: 12px;
        background: #f3f4f7;
        color: #6b7280 !important;
        font-weight: 700;
    }

        .btn-cancel:hover {
            text-decoration: none;
            background: #e9eaee;
        }

    .btn-save {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 24px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #f96332, #ff8a5c);
        color: #fff;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 8px 20px rgba(249,99,50,.28);
        transition: opacity .15s;
    }

        .btn-save:disabled {
            opacity: .6;
            cursor: not-allowed;
        }
</style>

<div class="container-fluid">

    <a href="/AdminMessage/Index" class="f-back"><i class="zmdi zmdi-arrow-left"></i> Mesajlara dön</a>

    <div class="f-hero">
        <h2>Mesajı Güncelle</h2>
        <p>#@Model.MessageId numaralı mesaj · @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</p>
    </div>

    @if (ViewBag.ToxicError != null)
    {
        <div class="f-alert">
            <i class="zmdi zmdi-block"></i>
            <div>@ViewBag.ToxicError</div>
        </div>
    }

    <div class="f-card">
        <form method="post" action="/AdminMessage/UpdateMessage" onsubmit="onSave()">

            <input type="hidden" asp-for="MessageId" />
            <input type="hidden" asp-for="CreatedDate" />

            <div class="f-current">
                <span>Mevcut duygu etiketi</span>
                <span class="sentiment @sentimentClass">@sentimentText</span>
            </div>

            <div class="f-field">
                <label class="f-label" for="CustomerId">Müşteri</label>
                <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="f-input" required>
                    <option value="">Müşteri seçin…</option>
                </select>
            </div>

            <div class="f-field">
                <label class="f-label" for="Topic">Konu</label>
                <input asp-for="Topic" class="f-input" list="topicList" required />
                <datalist id="topicList">
                    <option value="Sipariş"></option>
                    <option value="Kargo"></option>
                    <option value="İade"></option>
                    <option value="Ödeme"></option>
                    <option value="Ürün"></option>
                    <option value="Diğer"></option>
                </datalist>
            </div>

            <div class="f-field">
                <label class="f-label" for="MessageText">Mesaj</label>
                <textarea asp-for="MessageText" class="f-input" required></textarea>
            </div>

            <div class="f-ai-note">
                <i class="zmdi zmdi-memory"></i>
                <div>
                    Güncellediğinde mesajın duygusu yapay zeka ile yeniden belirlenir.
                    Hakaret, tehdit veya toksik içerik barındıran mesajlar kaydedilmez.
                </div>
            </div>

            <div class="f-actions">
                <a href="/AdminMessage/Index" class="btn-cancel">Vazgeç</a>
                <button type="submit" class="btn-save" id="SaveBtn"><i class="zmdi zmdi-check"></i> Güncelle</button>
            </div>

        </form>
    </div>

</div>

<script>
    // AI kontrolü birkaç saniye sürebilir; iki kere basılmasın
    function onSave() {
        const btn = document.getElementById('SaveBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="zmdi zmdi-spinner zmdi-hc-spin"></i> Kontrol ediliyor...';
    }
</script>